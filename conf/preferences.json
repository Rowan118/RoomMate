{
    "first_name": {
        "label": "First name",
        "type": "text",
        "required": true
    },
    "last_name": {
        "label": "Last name",
        "type": "text",
        "required": true
    },
    "major": {
        "label": "Major",
        "type": "text",
        "required": true
    },
    "dorm": {
        "label": "Preferred residence hall",
        "type": "select",
        "options": ["Regents", "Stimson", "Rogers", "McEachern", "McCrosky", "Streit Perham", "Orton"],
        "required": true,
        "matching": {
            "type": "hard"
        }
    },
    "room_type": {
        "label": "Would you prefer a roommate or single room?",
        "type": "select",
        "options": ["Single", "Double"],
        "required": true,
        "matching": {
            "type": "hard"
        }
    },
    "age": {
        "label": "What age range are you in?",
        "type": "select",
        "options": ["<=18", "19-20", "21+"],
        "required": true,
        "matching": {
            "type": "soft",
            "weight": 10
        }
    },
    "gender": {
        "label": "What gender do you identify as?",
        "type": "select",
        "options": ["Man", "Woman", "Non-Binary"],
        "required": true,
        "matching": {
            "type": "hard"
        }
    },
    "prefers_same_gender": {
        "label": "Would you rather only share a room with someone of the same gender?",
        "type": "boolean",
        "required": true
    },
    "wake_time": {
        "label": "What time do you generally wake up around?",
        "type": "select",
        "options": ["Before 7AM", "Between 7AM-9AM", "Between 9AM-12PM", "Between 12PM-3PM", "After 3PM"],
        "required": true,
        "matching": {
            "type": "soft",
            "weight": 20
        }
    },
    "sleep_time": {
        "label": "What time do you generally fall sleep around?",
        "type": "select",
        "options": ["Before 9PM", "Between 9PM-11PM", "Between 11PM-1AM", "Between 1AM-3AM", "After 3AM"],
        "required": true,
        "matching": {
            "type": "soft",
            "weight": 40
        }
    },
    "alcohol_preference": {
        "label": "Would you want to share a room with someone who drinks alcohol?",
        "type": "boolean",
        "required": true,
        "matching": {
            "type": "soft",
            "weight": 15
        }
    },
    "temperature_preference": {
        "label": "What temperature range are you comfortable with?",
        "type": "select",
        "options": ["<68°F", "68°F-72°F", "72°F+"],
        "required": false,
        "matching": {
            "type": "soft",
            "weight": 10
        }
    }
}